+static void append_name( WCHAR *buffer, UINT size, const WCHAR *str, UINT len )
+{
+    UINT pos = lstrlenW( buffer );
+
+    if (!len) return;
+    if (pos && pos < size - 1) buffer[pos++] = ' ';
+    len = min( len, size - 1 - pos );
+    memcpy( buffer + pos, str, len * sizeof(WCHAR) );
+    buffer[pos + len] = 0;

+    if (offset + offsetof( struct tt_stat_axis_value, value ) > var->stat_size) return NULL;
+    value = (const struct tt_stat_axis_value *)((const BYTE *)var->stat + offset);
+    switch (GET_BE_WORD( value->format ))
+    {

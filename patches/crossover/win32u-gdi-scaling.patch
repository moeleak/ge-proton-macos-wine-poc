+    case 2: value_size = sizeof(struct tt_stat_axis_value); break;
+    case 3: value_size = offsetof( struct tt_stat_axis_value, rangeMaxValue ); break;
+    case 4:
+        value_size = offsetof( struct tt_stat_axis_value, value ) +

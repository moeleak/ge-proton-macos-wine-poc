     unaware = gdi_scaling ? DPI_AWARENESS_CONTEXT_UNAWARE_GDISCALED : DPI_AWARENESS_CONTEXT_UNAWARE;
 
     if (QueryActCtxSettingsW( 0, NULL, L"http://schemas.microsoft.com/SMI/2016/WindowsSettings",
diff --git a/dlls/winemac.drv/macdrv_main.c b/dlls/winemac.drv/macdrv_main.c
index 56e7a77..a2dca00 100644
--- a/dlls/winemac.drv/macdrv_main.c
+++ b/dlls/winemac.drv/macdrv_main.c
@@ -242,6 +242,42 @@ ULONG query_reg_value(HKEY hkey, const WCHAR *name, KEY_VALUE_PARTIAL_INFORMATIO
 }
 
 
+/***********************************************************************
+ *              get_prefix_dpi
+ *
+ * The DPI the prefix is set to: the user's, or else the system's, as
+ * win32u reads it.
+ */
+static UINT get_prefix_dpi(void)
+{
+    static const WCHAR log_pixelsW[] = {'L','o','g','P','i','x','e','l','s',0};
+    static const char fonts_key[] =
+        "\\Registry\\Machine\\System\\CurrentControlSet\\Hardware Profiles\\Current\\Software\\Fonts";
+    char buffer[FIELD_OFFSET(KEY_VALUE_PARTIAL_INFORMATION, Data[sizeof(DWORD)])];
+    KEY_VALUE_PARTIAL_INFORMATION *value = (void *)buffer;
+    WCHAR fonts_keyW[ARRAY_SIZE(fonts_key)];
+    UINT dpi = 0, i;
+    HKEY hkey;
+
+    if ((hkey = open_hkcu_key("Control Panel\\Desktop")))
+    {
+        if (query_reg_value(hkey, log_pixelsW, value, sizeof(buffer)) == sizeof(DWORD) && value->Type == REG_DWORD)
+            dpi = *(const DWORD *)value->Data;
+        NtClose(hkey);
+    }
+
+    for (i = 0; i < ARRAY_SIZE(fonts_key); i++) fonts_keyW[i] = (unsigned char)fonts_key[i];
+    if (!dpi && (hkey = reg_open_key(NULL, fonts_keyW, (ARRAY_SIZE(fonts_key) - 1) * sizeof(WCHAR))))
+    {
+        if (query_reg_value(hkey, log_pixelsW, value, sizeof(buffer)) == sizeof(DWORD) && value->Type == REG_DWORD)
+            dpi = *(const DWORD *)value->Data;
+        NtClose(hkey);
+    }
+
+    return dpi ? dpi : USER_DEFAULT_SCREEN_DPI;
+}
+
+
 /***********************************************************************
  *              get_config_key
  *
@@ -393,6 +429,13 @@ static void setup_options(void)
        processes in the prefix. */
     if (!get_config_key(hkey, NULL, "RetinaMode", buffer, sizeof(buffer)))
         retina_enabled = IS_OPTION_TRUE(buffer[0]);
+    else
+    {
+        /* Without a RetinaMode setting, use retina mode in prefixes set to a high DPI, as new
+           ones are (loader/wine.inf), so that high-DPI displays show them sharp, while those
+           set to 96 DPI keep their size in points. */
+        retina_enabled = get_prefix_dpi() >= 2 * USER_DEFAULT_SCREEN_DPI;
+    }
 
     retina_on = retina_enabled;
 

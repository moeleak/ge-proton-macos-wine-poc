Subject: macOS: retina mode, 192 DPI and GDI scaling by default
License: LGPL-2.1-or-later
Modification date: 2026-11-22

New prefixes are set to 192 DPI (loader/wine.inf). Without a RetinaMode setting, the
Mac driver uses retina mode in prefixes set to a DPI of at least 192, as those are, so
that high-DPI displays show them sharp, while prefixes set to 96 DPI, such as those made
before, keep their size in points. DPI unaware processes use GDI scaling (see
win32u-gdi-scaling.patch) unless their manifest sets gdiScaling or the GdiScaling value
of HKCU\Software\Wine is off, so that their GDI drawing, menus and text included, is
rasterized at the scale of a high-DPI display rather than stretched; at 96 DPI it draws
at a scale of 1, as before.

diff --git a/dlls/user32/sysparams.c b/dlls/user32/sysparams.c
index 50f12ca..55ffdbb 100644
--- a/dlls/user32/sysparams.c
+++ b/dlls/user32/sysparams.c
@@ -156,17 +156,35 @@ void release_display_dc( HDC hdc )
     LeaveCriticalSection( &display_dc_section );
 }
 
-static BOOL get_manifest_gdi_scaling(void)
+/* Whether a DPI unaware process uses GDI scaling: as its manifest's gdiScaling says, or else,
+ * unless the GdiScaling value of HKCU\Software\Wine turns it off, it does, so that high-DPI
+ * displays show its GDI drawing sharp. At 96 DPI it draws at a scale of 1 anyway. */
+static BOOL get_gdi_scaling(void)
 {
     WCHAR buffer[16];
+    DWORD size, type;
+    BOOL ret = TRUE;
+    HKEY hkey;
 
     /* the null terminator is written even when the size doesn't account for it */
-    if (!QueryActCtxSettingsW( 0, NULL, L"http://schemas.microsoft.com/SMI/2017/WindowsSettings",
-                               L"gdiScaling", buffer, ARRAY_SIZE(buffer) - 1, NULL ))
-        return FALSE;
+    if (QueryActCtxSettingsW( 0, NULL, L"http://schemas.microsoft.com/SMI/2017/WindowsSettings",
+                              L"gdiScaling", buffer, ARRAY_SIZE(buffer) - 1, NULL ))
+    {
+        TRACE( "got gdiScaling=%s\n", debugstr_w(buffer) );
+        return !wcsicmp( buffer, L"true" );
+    }
 
-    TRACE( "got gdiScaling=%s\n", debugstr_w(buffer) );
-    return !wcsicmp( buffer, L"true" );
+    if (!RegOpenKeyExW( HKEY_CURRENT_USER, L"Software\\Wine", 0, KEY_QUERY_VALUE, &hkey ))
+    {
+        size = sizeof(buffer) - sizeof(WCHAR);
+        if (!RegQueryValueExW( hkey, L"GdiScaling", NULL, &type, (BYTE *)buffer, &size ) && type == REG_SZ && size)
+        {
+            buffer[size / sizeof(WCHAR)] = 0;
+            ret = !!wcschr( L"yYtT1", buffer[0] );
+        }
+        RegCloseKey( hkey );
+    }
+    return ret;
 }
 
